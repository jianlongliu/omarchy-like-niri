{
  "bar": {
    "centerAnchor": "omarchy.clock",
    "layout": {
      "center": [
        {
          "id": "jianlongliu.indicators",
          "items": [
            "Dictation",
            "ScreenRecording",
            "Dnd",
            "NightLight",
            "StayAwake"
          ]
        },
        {
          "id": "omarchy.spacer",
          "size": 16
        },
        {
          "id": "coding-sparrow.systempulse",
          "checkConnectivity": true,
          "compactBar": false,
          "notifications": true,
          "showCpu": true,
          "showGpu": false,
          "showMem": false
        },
        {
          "id": "omarchy.clock"
        },
        {
          "id": "jianlongliu.keyboard-layout"
        },
        {
          "id": "omarchy.weather"
        },
        {
          "id": "omarchy.power"
        },
        {
          "id": "omarchy.spacer"
        },
        {
          "id": "omarchy.media"
        },
        {
          "id": "jianlongliu.system-update"
        }
      ],
      "left": [
        {
          "id": "jianlongliu.arch-logo"
        },
        {
          "id": "jianlongliu.workspaces"
        },
        {
          "id": "omarchy.active-window"
        },
        {
          "id": "meviusisback.ai-subs",
          "barDisplay": "Data",
          "defaultSub": "opencode"
        }
      ],
      "right": [
        {
          "id": "omarchy.agents"
        },
        {
          "id": "srozen.ufw"
        },
        {
          "id": "omarchy.microphone"
        },
        {
          "id": "io.github.majesticio.clipboard-button"
        },
        {
          "id": "charlieras262.omablur"
        },
        {
          "id": "io.github.sahzudin.omarchy-screenshot-manager"
        },
        {
          "id": "jrmmhm.pocket",
          "members": "srozen.ufw, omarchy.microphone, io.github.majesticio.clipboard-button, charlieras262.omablur, io.github.sahzudin.omarchy-screenshot-manager"
        },
        {
          "id": "omarchy.tray",
          "hidden": [
            "Fcitx"
          ]
        },
        {
          "id": "ronald.input-sources",
          "showSourceName": false
        },
        {
          "id": "omarchy.bluetooth"
        },
        {
          "id": "omarchy.network"
        },
        {
          "id": "omarchy.audio"
        },
        {
          "id": "omarchy.monitor"
        },
        {
          "id": "omarchy-system-menu"
        }
      ]
    },
    "position": "top",
    "transparent": false,
    "id": "charlieras262.floating-bar"
  },
  "idle": {
    "lock": 1200,
    "screensaver": 86400
  },
  "plugins": [
    {
      "id": "io.github.sirjul1337.lock-explorer",
      "design": "split"
    },
    {
      "id": "andreconde.quick-look"
    },
    {
      "id": "io.github.jonhenshaw.voxtype-prism"
    },
    {
      "id": "abdul.hotcorners"
    },
    {
      "id": "io.github.ellion369.omagent"
    },
    {
      "id": "jianlongliu.osd"
    },
    {
      "id": "io.github.maajix.spotlight"
    }
  ],
  "version": 1,
  "disabledPlugins": [
    "omarchy.lock",
    "omarchy.nightlight",
    "omarchy.osd"
  ],
  "cloneSourceRestores": [
    "io.github.sirjul1337.lock-explorer",
    "jianlongliu.osd"
  ]
}
