+# The wait after the passphrase. On a design snapshot the wait grows a line
+# down the design's own panel divider (auto finds that edge in the picture, so
+# nothing is added that the design does not already have); off keeps the old
+# spinner, and a number pins the edge by hand as a percent of the width.
+wait_line=$(val wait_line auto);  wait_line_w=$(val wait_line_width 6)
 
 accent_i=$(hex_ints "$accent_t"); bg_i=$(hex_ints "$bg_t")
 fg_f=$(hex_floats "$fg_t"); dim_f=$(hex_floats "$dim_t"); bg_f=$(hex_floats "$bg_t")
 title_f=$(hex_floats "$title_c"); subtitle_f=$(hex_floats "$subtitle_c")
 
+# X of the strongest vertical edge in the middle of a picture, as a percent of
+# its width -- the divider between a wallpaper and a design's own panel. The
+# picture is treated as the full 3840x2160 canvas the theme script maps onto
+# the screen, so the percent carries over unchanged. Three bands have to agree
+# (a busy wallpaper cannot fake an edge twice), otherwise nothing is printed
+# and the caller falls back to the plain spinner.
+panel_edge_x() {
+  local img=$1 w band y x hits=()
+  w=$(magick identify -format '%w' "$img")
+  for f in 30 50 70; do
+    y=$(awk -v f=$f 'BEGIN{ printf "%d", 2160*f/100 - 2160*0.075 }')
+    band=$(awk 'BEGIN{ printf "%d", 2160*0.15 }')
+    x=$( { magick "$img" -crop "${w}x${band}+0+${y}" +repage -resize "${w}x1!" -depth 8 txt:- |
+      awk -F'[,:() ]+' '
+        /^[0-9]+,[0-9]+:/ {
+          l = 0.2126*$3 + 0.7152*$4 + 0.0722*$5
+          if (prev != "") { d = l - prev; if (d < 0) d = -d
+            if (d > best) { best = d; bx = $1 } }
+          prev = l
+        }
+        END { if (best >= 20) print bx }'; } 2>/dev/null || true )
+    if [[ -n $x ]]; then hits+=("$x"); fi
+  done
+  (( ${#hits[@]} >= 2 )) || return 0
+  local a b d bestd=99 best=""
+  for a in "${hits[@]}"; do
+    for b in "${hits[@]}"; do
+      d=$(( a > b ? a - b : b - a ))
+      if (( d < bestd )); then bestd=$d; best=$(( (a + b) / 2 )); fi
+    done
+  done
+  (( bestd <= 6 )) || return 0
+  awk -v x="$best" -v w="$w" 'BEGIN{ printf "%.2f", 100 * x / w }'
+}
